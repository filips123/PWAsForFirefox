## Widget names and tooltips should be translated in the same style and capitalization as existing Firefox messages in your language
## Example: https://pontoon.mozilla.org/sl/firefox/browser/browser/browser.ftl/?search=toolbar-button&search_identifiers=true
## Example: https://pontoon.mozilla.org/sl/firefox/browser/browser/browser.ftl/?search=navbar&search_identifiers=true

toolbar-button-mute =
    .label = Activar/Desactivar Sonido
    .tooltiptext = Activar/Desactivar el sonido de la página {{$shortcut}}
toolbar-button-reader-view =
    .label = Vista de lectura
    .tooltiptext = Alternar vista de lectura ({ $shortcut })
toolbar-button-copy-link =
    .label = Copiar enlace
    .tooltiptext = Copiar el enlace a esta página
toolbar-button-share-link =
    .label = Compartir enlace
    .tooltiptext = Compartir enlace a esta página
toolbar-button-send-to-device =
    .label = Enviar al Dispositivo
    .tooltiptext = Enviar esta página a otro dispositivo
toolbar-button-open-in-browser =
    .label = Abrir en el Navegador
    .tooltiptext = Abrir esta página en el navegador
toolbar-button-tracking-protection =
    .label = Protección contra el rastreo
    .tooltiptext = Ver información sobre la protección de rastreo en este sitio
toolbar-button-identity =
    .label = Información del sitio
    .tooltiptext = Ver información sobre este sitio
toolbar-button-permissions =
    .label = Permisos del sitio
    .tooltiptext = Ver permisos otorgados a este sitio
toolbar-button-notifications =
    .label = Notificaciones del sitio
    .tooltiptext = Notificaciones emergentes para este sitio
toolbar-button-close =
    .label = Cerrar
    .tooltiptext = Cerrar la página actual
toolbar-button-home-ffpwa =
    .label = { navbar-home.label }
    .tooltiptext = Página de inicio de App

## Internal messages that should not be translated

